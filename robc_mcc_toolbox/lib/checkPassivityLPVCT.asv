function [P,diagnostics] = checkPassivityLPVCT(A,B,C,D,pa,pb,pc,pd)
% Check passivity for LPV systems

% Initial value
A0 =  A(pa(1,:));
B0 =  B(pb(1,:));
C0 =  C(pc(1,:));
D0 =  D(pd(1,:));

% Passitive check based on the positive lemma
nx = size(B0,1); 
nu = size(B0,2); 
ny = size(C0,1);

Pvar = sdpvar(nx,nx);
ops = sdpsettings('solver','mosek','verbose',0);
Constraints = [];

if norm(D0, inf)==0
    % if D is zero, i.e., no feedthrough
    for i=1:length(pa)
        Constraints = [Constraints, A(pa(i,:))'*Pvar+Pvar*A(pa(i,:))<=-1e-6];
    end
    Constraints = [Constraints, B(pb(i,:))'*Pvar == C(pc(i,:))];
else
    % General formulation
    for i=1:size(pa,1)
        Constraints = [Constraints, ...
                [A(pa(i,:))'*Pvar+Pvar*A(pa(i,:)), ...
                Pvar*B(pb(i,:))-C(pc(i,:))'; ...
                B(pb(i,:))'*Pvar-C(pc(i,:)), ...
                -D(pd(i,:))-D(pd(i,:))']<=-1e-8];
    end
    Constraints = [Constraints, Pvar>=1e-6];
end

% Optimization
diagnostics = optimize(Constraints,[],ops);

P = value(Pvar);

end